# Pin both the base filesystem and the signed package repository.
FROM docker.io/library/archlinux@sha256:694da1fce635e3a14d90751941b08f02c500e8724682f7a00768e7152251ec34
RUN printf 'Server = https://archive.archlinux.org/repos/2026/09/01/$repo/os/$arch\n' > /etc/pacman.d/mirrorlist && \
    sed -i '/^\[options\]/a XferCommand = /usr/bin/curl --http1.1 -fsSL -C - --retry 5 --retry-all-errors --connect-timeout 30 --max-time 600 -o %o %u' /etc/pacman.conf
RUN --mount=type=cache,target=/var/cache/pacman/pkg \
    pacman -Syyuu --noconfirm && \
    pacman -S --noconfirm --needed \
        base-devel git sudo rust cargo clang \
        pipewire pipewire-audio pipewire-alsa pipewire-pulse wireplumber \
        sway wl-clipboard alsa-lib alsa-utils openssl dbus \
        python python-pytest && \
    useradd -m builder && \
    setcap -r /usr/bin/sway
WORKDIR /tests
CMD ["/bin/bash"]
